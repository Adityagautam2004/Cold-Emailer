{
  "name": "dispatch",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "build": "npm run build -w packages/config && npm run build -w packages/core && npm run build -w apps/web",
    "start:worker": "npm run start -w apps/worker",
    "typecheck": "npm run typecheck -w packages/config && npm run typecheck -w packages/core && npm run typecheck -w apps/web && npm run typecheck -w apps/worker",
    "lint": "npm run lint -w apps/web",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.4",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "@types/node": "^20.14.15",
    "dotenv-cli": "^7.4.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@types/node": "^20.14.15"
  }
}
